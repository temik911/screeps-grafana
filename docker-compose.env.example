# SCREEPS_SHARD: one shard, or a comma list for multi-shard (e.g. shard2,shard3). Metrics are
# namespaced as stats.gauges.<shard>.* (dashboard templates on $shard).
SCREEPS_SHARD=shard3
# SCREEPS_TOKEN: a single token (reused for every shard) or a comma list aligned with SCREEPS_SHARD.
# NOTE: the 360 req/h memory-segment limit is SHARED across an account's tokens — extra tokens do NOT
# add budget, so a single token is fine. The poller spaces requests at SCREEPS_POLL_BASE_MS × shardCount
# (default base 10s → 360 req/h total, right at the cap) regardless of shard or token count.
SCREEPS_TOKEN=your-auth-token-from-screeps.com/a/#!/account/auth-tokens
SCREEPS_HOST=https://screeps.com
SCREEPS_SEGMENT=15
# Optional: base poll interval in ms (per request slot). Default 10000 (= 360 req/h, the cap). Bump to
# 12000 for headroom (300 req/h). Total req/h = 3600000/base.
# SCREEPS_POLL_BASE_MS=10000

# Shared secret between grafana and the image renderer (see the `renderer` service in
# docker-compose.yml). Grafana REFUSES TO START in production mode if this is left at the built-in
# default, so it must be set to something random before `compose up`: openssl rand -hex 24
RENDERER_TOKEN=run-openssl-rand-hex-24-and-paste-here

# --- only for docker-compose.proxy.yml (Grafana behind a reverse proxy on a public domain) ---
# PROXY_NETWORK=name_of_the_external_docker_network
# PROXY_ALIAS=grafana
# GRAFANA_ROOT_URL=https://example.com/grafana/
# GRAFANA_CALLBACK_URL=http://grafana:3000/grafana/
